# LLM 问答配置（复制为 .env 并填写，OpenAI 兼容协议）
# 方案 A：复用 OpenCode Go 订阅（零额外成本）
KB_LLM_BASE_URL=https://opencode.ai/zen/go/v1
KB_LLM_API_KEY=your-go-api-key-here
KB_LLM_MODEL=glm-5.2

# 方案 B：智谱开放平台
# KB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# KB_LLM_MODEL=glm-4-plus

# 方案 C：本地 Ollama
# KB_LLM_BASE_URL=http://localhost:11434/v1
